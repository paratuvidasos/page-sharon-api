PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=page_sharon_dev

FRONTEND_URL=http://localhost:5190
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Secreto para firmar los access tokens (JWT). Genera uno propio por entorno, nunca reutilices este valor.
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=1
REFRESH_TOKEN_REMEMBER_ME_TTL_DAYS=30
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_MINUTES=15

# --- Clerk (login con Google) ---
# Secret Key del backend de Clerk (Dashboard > API Keys). Nunca se expone al
# frontend — solo se usa para verificar del lado del servidor el session
# token que Clerk emite en el cliente tras "Continuar con Google".
CLERK_SECRET_KEY=

# Sin BREVO_API_KEY, los correos se imprimen en consola (ConsoleEmailSender) en vez de enviarse de verdad.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME=Sharon

# URL pública de este backend (para construir URLs de archivos subidos, ej. foto de perfil).
# Se usa como fallback cuando CLOUDINARY_URL (abajo) no está configurado.
API_PUBLIC_URL=http://localhost:3000
UPLOADS_DIR=uploads
AVATAR_MAX_SIZE_MB=5

# --- Cloudinary (subida de imágenes: avatares, productos, banners) ---
# Vacío = se guarda en disco local (UPLOADS_DIR de arriba), sin subir a la nube.
# Copiar el valor completo de "API environment variable" en Cloudinary Console
# > Settings > API Keys (formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME).
CLOUDINARY_URL=

# --- Bold (pasarela de pago) ---
# Mientras BOLD_API_KEY esté vacío se usa una pasarela simulada local y ningún
# pago es real, igual que BREVO_API_KEY vacío hace que los correos vayan a
# consola. Con la cuenta creada, poner estas dos llaves es lo único pendiente.
# La llave de identidad se expone al navegador (es su uso previsto, va en
# data-api-key); la secreta NUNCA sale del backend: firma la integridad y
# verifica el HMAC del webhook.
BOLD_API_KEY=
BOLD_SECRET_KEY=
# sandbox | production. En production se exigen ambas llaves y se rechaza la
# pasarela simulada.
BOLD_ENVIRONMENT=sandbox
BOLD_STATUS_API_URL=https://payments.api.bold.co
# embedded = la pasarela se pinta dentro de nuestra página; redirect = se sale a Bold.
BOLD_CHECKOUT_RENDER_MODE=embedded
BOLD_PAYMENT_EXPIRATION_MINUTES=30

# A dónde vuelve el comprador al salir de la pasarela.
CHECKOUT_RESULT_URL=http://localhost:5190/checkout/resultado

# Cuánto tiempo se aparta el stock mientras el comprador completa el pago.
STOCK_RESERVATION_TTL_MINUTES=30

# [0041]: tasa usada para cobrar en USD. Se congela en cada pedido al comprar.
EXCHANGE_RATE_USD_COP=4100
SUPPORTED_CURRENCIES=COP,USD

# [0067]/[0068]: idiomas que ofrece el selector de la tienda. Siempre incluye
# "es" aunque no se liste acá — es el idioma en el que está escrito el
# catálogo base.
SUPPORTED_LOCALES=es,en

# --- [0070] Detección de idioma/moneda por ubicación (geo-IP) ---
# Sin GEOIP_API_URL/GEOIP_API_KEY, la sugerencia se degrada a Accept-Language
# y luego a los valores por defecto — mismo criterio que CARRIER_RATES_*: la
# falta de credenciales degrada el servicio, no impide arrancar.
GEOIP_API_URL=
GEOIP_API_KEY=
GEOIP_TIMEOUT_MS=4000

# [0021] Reseñas. Apagado: cualquiera con cuenta puede reseñar. El negocio ya
# lleva años operando y buena parte de su clientela compró antes de que
# existiera este sistema, así que exigir compra verificada dejaría fuera a
# quienes más tienen que contar. Activar cuando el histórico de pedidos
# propios sea representativo.
REVIEWS_REQUIRE_VERIFIED_PURCHASE=false

# --- [0048] Transportadora (cálculo de tarifas de envío) ---
# La transportadora concreta todavía está pendiente de definir. Mientras
# CARRIER_RATES_API_URL o CARRIER_API_KEY estén vacías, los envíos se cotizan
# con la tarifa de respaldo configurada en la tabla shipping_rates, que es
# exactamente el comportamiento que había antes de esta US. A diferencia de la
# pasarela de pago, acá no se exige credencial en producción: cotizar con la
# tarifa manual es un modo de operación legítimo, no una simulación.
CARRIER_RATES_API_URL=
CARRIER_API_KEY=
CARRIER_CODE=
CARRIER_NAME=
# El checkout está esperando esta respuesta: al vencer el plazo se aborta y se
# usa el respaldo. No hay reintento — duplicaría la espera del comprador por el
# mismo resultado incierto.
CARRIER_RATES_TIMEOUT_MS=4000

# --- Tracking real de envíos (Track123) ---
# Sin TRACK123_API_SECRET o TRACK123_COURIER_CODE, los envíos no se
# sincronizan con la transportadora y el sistema arranca igual (mismo
# criterio que CARRIER_RATES_*): el panel simplemente no tiene tracking real
# que mostrar todavía. El código de transportadora es el que usa Track123
# internamente, no el que escribe el admin al despachar — hoy Inter
# Rapidísimo es "inter-rapidisimo-inter-rapidsimo".
TRACK123_API_SECRET=
TRACK123_COURIER_CODE=inter-rapidisimo-inter-rapidsimo
TRACK123_TIMEOUT_MS=8000
# Expresión cron de node-cron para el barrido de sincronización.
TRACKING_SYNC_CRON=*/30 * * * *
